<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neo-Cinema | ScreenIT</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="dashboard-body has-scroll">
    <nav class="neo-navbar">
        <div class="nav-left">
            <div class="nav-brand">
                <a href="/dashboard">NEO<span>CINEMA</span></a>
            </div>
            <div class="nav-links-main">
                <a href="/dashboard" class="nav-link">Hub</a>
                <a href="/screenit/browse" class="nav-link active">ScreenIT</a>
            </div>
        </div>
        <div class="nav-right">
            <div class="nav-user-profile">
                <div class="avatar-circle">
                    <%= user.fullName[0] %>
                </div>
            </div>
        </div>
    </nav>

    <div class="dashboard-container">
        <header class="screenit-header fade-in-up">
            <h1>Screen<span class="highlight-cyan">IT</span></h1>
            <p>Don't just watch. Curate. Promote. Earn.</p>
        </header>

        <section class="screenit-grid">
            <div class="curate-card fade-in-up">
                <div class="card-visual" style="background-image: url('https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=800&auto=format&fit=crop')">
                    <div class="visual-overlay">
                        <h3>Start Your Own <span class="highlight-cyan">Show</span></h3>
                        <p>Pick a movie, choose a theater, and invite your network.</p>
                    </div>
                </div>
                <div class="card-form">
                    <form action="/screenit/create" method="POST">
                        <div class="field-wrap">
                            <label>Choose Movie</label>
                            <select name="movieId" class="neo-select-premium" required>
                                <% movies.forEach(function(m) { %>
                                <option value="<%= m._id %>"><%= m.title %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="field-wrap">
                            <label>Select Theater</label>
                            <select name="theater" class="neo-select-premium" required>
                                <option value="IMAX Central">IMAX Central</option>
                                <option value="Neo Multiplex">Neo Multiplex</option>
                                <option value="Starlight Cinema">Starlight Cinema</option>
                            </select>
                        </div>
                        <div class="command-grid">
                            <div class="field-wrap">
                                <label>Date</label>
                                <input type="date" name="showDate" required>
                            </div>
                            <div class="field-wrap">
                                <label>Time</label>
                                <select name="showTime" class="neo-select-premium" required>
                                    <option value="6:00 PM">6:00 PM</option>
                                    <option value="9:00 PM">9:00 PM</option>
                                </select>
                            </div>
                        </div>
                        <button type="submit" class="btn-neo btn-cyan">🚀 Launch Screening</button>
                    </form>
                </div>
            </div>

            <div class="active-screenings fade-in-up" style="animation-delay: 0.2s">
                <div class="section-header">
                    <h3>Active <span class="highlight-crimson">Requests</span></h3>
                    <p>Join a show and help it reach the threshold.</p>
                </div>
                
                <% if (activeScreenings.length === 0) { %>
                    <div class="empty-state">
                        <p>No active screenings. Be the first to start one!</p>
                    </div>
                <% } else { %>
                    <div class="screenings-list">
                        <% activeScreenings.forEach(function(s) { %>
                            <div class="screening-item glass-panel">
                                <div class="screening-movie-art">
                                    <img src="<%= s.movie.posterUrl %>" alt="">
                                </div>
                                <div class="screening-info">
                                    <h4><%= s.movie.title %></h4>
                                    <p class="meta"><%= s.theater %> • <%= new Date(s.showDate).toLocaleDateString() %></p>
                                    <div class="progress-container">
                                        <div class="progress-bar">
                                            <div class="progress-fill" style="width: <%= (s.currentBookings / s.threshold) * 100 %>%"></div>
                                        </div>
                                        <span class="progress-text"><%= s.currentBookings %>/<%= s.threshold %> Booked</span>
                                    </div>
                                    <a href="/screenit/join/<%= s._id %>" class="btn-neo btn-small">Join Show</a>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </section>
    </div>
</body>
</html>
