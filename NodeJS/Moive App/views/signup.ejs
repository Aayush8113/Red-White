<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neo-Cinema | Audition</title>
    <link rel="stylesheet" href="/style.css">
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme');
            const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            const theme = savedTheme || systemTheme;
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body class="split-layout">
    <div class="split-visual signup-visual" style="background-image: url('https://images.unsplash.com/photo-1536440136628-849c177e76a1?q=80&w=2000&auto=format&fit=crop');">
        <div class="visual-overlay">
            <h1>Your Story<br><span class="highlight-cyan">Begins Here.</span></h1>
            <p>Join the premier vault for cinematic curators.</p>
        </div>
    </div>

    <div class="split-form-container">
        <div class="form-wrapper glass-panel fade-in-up">

            <div class="auth-icon">
                <span title="Clapperboard">🎥</span>
            </div>

            <!-- Step indicator -->
            <div class="step-indicator">
                <div class="step-dot active" id="dot1"></div>
                <div class="step-dot" id="dot2"></div>
                <div class="step-dot" id="dot3"></div>
            </div>

            <h2 class="form-title"><span class="highlight-cyan">Audition</span></h2>

            <% if (error) { %>
                <div class="error-glow">
                    <%= error %>
                </div>
                <% } %>

                    <form action="/signup" method="POST" class="neo-form" id="signupForm">
                        <!-- Full Name with icon -->
                        <div class="icon-input">
                            <span class="input-icon">👤</span>
                            <div class="input-float">
                                <input type="text" name="fullName" id="fullName" placeholder=" " required
                                    autocomplete="name">
                                <label for="fullName">Director Name</label>
                            </div>
                        </div>

                        <!-- Username with icon -->
                        <div class="icon-input">
                            <span class="input-icon">@</span>
                            <div class="input-float">
                                <input type="text" name="username" id="username" placeholder=" " required
                                    autocomplete="username">
                                <label for="username">Studio ID (Username)</label>
                            </div>
                        </div>

                        <!-- Password with toggle + strength -->
                        <div>
                            <div class="pw-wrapper icon-input">
                                <span class="input-icon">🔒</span>
                                <div class="input-float">
                                    <input type="password" name="password" id="password" placeholder=" " required
                                        autocomplete="new-password">
                                    <label for="password">Secure Passcode</label>
                                </div>
                                <button type="button" class="pw-toggle" id="togglePw" aria-label="Show password">
                                    <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                        fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </button>
                            </div>
                            <div class="pw-strength">
                                <div class="pw-strength-bar">
                                    <div class="pw-strength-fill" id="strengthFill"></div>
                                </div>
                                <span class="pw-strength-label" id="strengthLabel">Enter a password</span>
                            </div>
                        </div>

                        <button type="submit" class="btn-neo btn-cyan" id="submitBtn" style="width:100%;">Register
                            Account</button>
                    </form>

                    <p class="auth-switch">Already a member? <a href="/login">Enter Studio</a></p>
        </div>
    </div>

    <div class="cursor-glow" id="cursorGlow"></div>

    <script>
        // Cursor glow
        const glow = document.getElementById('cursorGlow');
        document.addEventListener('mousemove', e => {
            glow.style.left = e.clientX + 'px';
            glow.style.top = e.clientY + 'px';
        });

        // Password toggle
        const togglePw = document.getElementById('togglePw');
        const pwInput = document.getElementById('password');
        const eyeIcon = document.getElementById('eyeIcon');
        togglePw.addEventListener('click', () => {
            const shown = pwInput.type === 'text';
            pwInput.type = shown ? 'password' : 'text';
            eyeIcon.innerHTML = shown
                ? '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>'
                : '<path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';
        });

        // Password strength
        const strengthFill = document.getElementById('strengthFill');
        const strengthLabel = document.getElementById('strengthLabel');
        const dots = [document.getElementById('dot1'), document.getElementById('dot2'), document.getElementById('dot3')];
        const inputs = [document.getElementById('fullName'), document.getElementById('username'), pwInput];

        function updateDots() {
            inputs.forEach((inp, i) => {
                dots[i].classList.toggle('active', inp.value.trim().length > 0);
            });
        }
        inputs.forEach(inp => inp.addEventListener('input', updateDots));

        pwInput.addEventListener('input', () => {
            const val = pwInput.value;
            let score = 0;
            if (val.length >= 6) score++;
            if (val.length >= 10) score++;
            if (/[A-Z]/.test(val) && /[0-9]/.test(val)) score++;
            const configs = [
                { w: '0%', color: '', label: 'Enter a password' },
                { w: '33%', color: 'var(--crimson-glow)', label: 'Weak' },
                { w: '66%', color: 'var(--amber-glow)', label: 'Medium' },
                { w: '100%', color: 'var(--green-glow)', label: 'Strong' }
            ];
            const cfg = val.length === 0 ? configs[0] : configs[Math.min(score + 1, 3)];
            strengthFill.style.width = cfg.w;
            strengthFill.style.background = cfg.color;
            strengthLabel.textContent = cfg.label;
            strengthLabel.style.color = cfg.color || 'var(--text-dim)';
        });

        // Page transition
        document.querySelectorAll('a[href]').forEach(a => {
            a.addEventListener('click', e => {
                e.preventDefault();
                document.body.style.animation = 'pageIn 0.3s ease reverse forwards';
                setTimeout(() => { window.location = a.href; }, 280);
            });
        });
    </script>
</body>

</html>