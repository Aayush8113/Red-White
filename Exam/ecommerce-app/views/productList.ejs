<%- include('partials/header') %>
<% 
  function getCategoryColor(name) {
      if(!name) return '#8b5cf6';
      let hash = 0;
      for (let i = 0; i < name.length; i++) {
          hash = name.charCodeAt(i) + ((hash << 5) - hash);
      }
      const hue = Math.abs(hash) % 360;
      return `hsl(${hue}, 70%, 55%)`;
  }
%>
<section class="hero-section">
    <div class="hero-content">
        <h1 class="gsap-hero">EvoStore Official</h1>
        <p class="gsap-hero">Premium products for everyday needs.</p>
    </div>
</section>

<section class="products-section">
    <div class="category-filters">
        <a href="/" class="cat-pill active">All</a>
        <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
                <a href="#<%= cat.name %>" class="cat-pill"><%= cat.name %></a>
            <% }) %>
        <% } %>
    </div>
    
    <h2 class="section-title">Latest Products</h2>
    <div class="product-grid">
        <% if (products && products.length > 0) { %>
            <% products.forEach(product => { %>
                <div class="product-card gsap-card" style="--cat-color: <%= getCategoryColor(product.category ? product.category.name : '') %>;">
                    <img src="<%= product.imageUrl %>" alt="<%= product.title %>">
                    <div class="product-info">
                        <h3><%= product.title %></h3>
                        <p class="category-tag"><%= product.category ? product.category.name : 'Uncategorized' %></p>
                        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                            <a href="/products/<%= product._id %>" class="btn-outline" style="flex:1;">View Details</a>
                            <button onclick="addToCart('<%= product._id %>', `<%= product.title.replace(/`/g, '') %>`, <%= product.price %>, '<%= product.imageUrl %>')" class="btn-primary" style="flex:1;">Add to Cart</button>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <p>No products found.</p>
        <% } %>
    </div>
</section>
<%- include('partials/footer') %>
