<%- include('partials/header') %>
    <section class="product-detail-section">
        <div class="product-detail-card">
            <div class="product-image">
                <img src="<%= product.imageUrl || '/default-image.jpg' %>" alt="<%= product.title || 'Product' %>">
            </div>
            <div class="product-details">
                <h2>
                    <%= product.title || 'Untitled Product' %>
                </h2>
                <p class="category-tag">
                    <%= product.category && product.category.name ? product.category.name : 'Uncategorized' %>
                </p>
                <p class="creator">Added by: <%= product.creator && product.creator.username ? product.creator.username : 'Unknown User' %></p>
                <h3 class="price">$<%= product.price || 0 %>
                </h3>
                <p class="description">
                    <%= product.description || 'No description available.' %>
                </p>
                <%
                    const safeTitle = (product.title || 'Untitled Product').replace(/['"`]/g, '');
                    const safeUrl = (product.imageUrl || '').replace(/['"`]/g, '');
                %>
                <button onclick="addToCart('<%= product._id %>', '<%= safeTitle %>', <%= product.price || 0 %>, '<%= safeUrl %>')" class="btn-primary" style="font-size: 1.1rem; padding: 0.8rem 2rem;">Add to Cart 🛒</button>
            </div>
        </div>
    </section>
    <%- include('partials/footer') %>