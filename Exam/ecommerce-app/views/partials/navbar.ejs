<nav class="navbar">
    <div class="nav-container">
        <a href="/" class="brand">EvoStore</a>
        
        <div class="nav-controls" style="display: flex; gap: 1rem; align-items: center;">
            <button id="theme-toggle" class="theme-toggle">🌙</button>
            <button id="mobile-menu-btn" class="hamburger-btn">
                <span></span><span></span><span></span>
            </button>
        </div>

        <ul class="nav-links" id="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/cart">Cart <span id="cart-badge" class="badge">0</span></a></li>
