<%- include('partials/header') %>
<% 
  function getCategoryColor(name) {
      if(!name) return '#8b5cf6';
      let hash = 0;
      for (let i = 0; i < name.length; i++) {
          hash = name.charCodeAt(i) + ((hash << 5) - hash);
      }
      const hue = Math.abs(hash) % 360;
      return `hsl(${hue}, 70%, 55%)`;
  }
%>
<section class="dashboard-section">
    <h2 class="section-title">My Products</h2>
    <a href="/products/create" class="btn-primary mb-2" style="display:inline-block; margin-bottom: 2rem;">Add New Product</a>
    <div class="product-grid">
        <% if (typeof products !== 'undefined' && products.length > 0) { %>
            <% products.forEach(product => { %>
                <div class="product-card gsap-card" style="--cat-color: <%= getCategoryColor(product.category ? product.category.name : '') %>;">
                    <img src="<%= product.imageUrl %>" alt="<%= product.title %>">
                    <div class="product-info">
                        <h3><%= product.title %></h3>
                        <p class="price">$<%= product.price %></p>
                        <div class="actions">
                            <form action="/products/delete/<%= product._id %>" method="POST">
                                <button type="submit" class="btn-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <p>You haven't added any products yet.</p>
        <% } %>
    </div>
</section>
<%- include('partials/footer') %>
